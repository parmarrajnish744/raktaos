# Supabase Backend Configuration
# Obtain these from your Supabase Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Configurable Public Domain URL
# Used for constructing public card links: ${VITE_APP_URL}/c/{slug}
# Example for production: https://mydomain.com
# Example for localhost: http://localhost:5173
VITE_APP_URL=http://localhost:5173
