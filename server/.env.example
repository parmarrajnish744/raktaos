PORT=5000
NODE_ENV=development

# Allowed CORS Origins (comma-separated for multiple domains)
# Example for production: https://raktabusiness.com,https://app.raktabusiness.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5000

# Supabase Production Backend Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Internal JWT signing secret (Used only for Express session signing if utilized)
JWT_SECRET=your-random-jwt-secret-min-32-chars

# Gemini / LLM API Key (Strictly server-side; NEVER expose to client)
GEMINI_API_KEY=your-gemini-api-key-here
